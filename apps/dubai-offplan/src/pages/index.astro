---
import Base from '../layouts/Base.astro';
import Container from '@estate/ui/Container.astro';
import Button from '@estate/ui/Button.astro';
import { development } from '../data/development';
const waNumber = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || '').replace(/\D/g, '');
const waHref = waNumber ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Hello. I would like to ask about MARIS Residences. I understand this is a portfolio demo.')}` : '#form-contact-preference';
const photos = [
  { src:'/assets/coastal-residence.svg',alt:'Original conceptual illustration of a modern coastal residence, not a real building',caption:'Architectural concept / not a constructed property',cls:'gallery__large' },
  { src:'/assets/interior-concept.svg',alt:'Original concept illustration of a sunlit contemporary interior',caption:'Interior mood study / illustrative',cls:'' },
  { src:'/assets/pool-concept.svg',alt:'Original concept illustration of a pool garden by modern residences',caption:'Landscape concept / illustrative',cls:'' }
];
---
<Base title="MARIS Residences Dubai Islands | Off-Plan Concept & Floor Plans" description="Explore MARIS Residences, a fictional Dubai Islands off-plan portfolio demo. Sample prices, payment plan, floor plans and enquiry form — no real inventory.">
  <div class="demo-band"><Container><span class="demo-dot" aria-hidden="true"></span> PORTFOLIO DEMO — FICTIONAL PROJECT, ILLUSTRATIVE PRICES & IMAGERY <a href="#disclosure">Read disclosure</a></Container></div>
  <header class="site-header">
    <Container className="header-inner">
      <a class="wordmark" href="/" aria-label="Maris Residences home">MARIS<span class="wordmark-dot">.</span><small>R E S I D E N C E S</small></a>
      <nav class="desktop-nav" aria-label="Main navigation"><a href="#overview">Overview</a><a href="#residences">Residences</a><a href="#payment">Payment plan</a><a href="#floorplans">Floor plans</a><a href="#location">Location</a></nav>
      <a class="header-cta" href="#enquire" data-track="start_form">Enquire now <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu"><summary aria-label="Toggle navigation"><span></span><span></span><span class="sr-only">Menu</span></summary><nav aria-label="Mobile navigation"><a href="#overview">Overview</a><a href="#residences">Residences</a><a href="#payment">Payment plan</a><a href="#floorplans">Floor plans</a><a href="#location">Location</a><a href="#enquire">Enquire</a></nav></details>
    </Container>
  </header>
  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">
      <Container className="hero-grid">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-line"></span> DUBAI ISLANDS · CONCEPT RELEASE</div>
          <h1 id="hero-heading">A quieter<br /><em>address</em><br />on the water.</h1>
          <p class="hero-intro">An imagined collection of coastal residences for the moments that matter beyond the city.</p>
          <div class="hero-actions"><Button href="#residences">Explore residences</Button><a class="text-link" href="#floorplans">See floor plans <span aria-hidden="true">↗</span></a></div>
          <p class="hero-note">Concept project. No property is being offered for sale.</p>
        </div>
        <div class="hero-visual"><img src="/assets/coastal-residence.svg" alt="Original architectural concept illustration of a coastal residence; fictional and not built" width="1800" height="1200" fetchpriority="high" /><div class="hero-image-label">FIG. 01 / THE COASTAL IDEA <span>ORIGINAL CONCEPT ART</span></div></div>
      </Container>
      <Container className="quickfacts" ><div><span>ILLUSTRATIVE STARTING PRICE</span><strong>AED 1.85M</strong></div><div><span>SAMPLE PAYMENT PLAN</span><strong>20 / 50 / 30</strong></div><div><span>SAMPLE HANDOVER</span><strong>Q4 2029</strong></div><a href="#enquire">Request project details <span aria-hidden="true">↗</span></a></Container>
    </section>

    <section class="section section--overview" id="overview" aria-labelledby="overview-heading"><Container>
      <div class="section-kicker"><span>01 / THE PROJECT</span><span>CONCEPT DEVELOPMENT OVERVIEW</span></div>
      <div class="editorial-grid"><div><p class="overline">A different perspective</p><h2 id="overview-heading" class="display-heading">Space to <em>live</em><br />a little slower.</h2></div><div class="editorial-body"><p>MARIS is an original, fictional residential concept situated on Dubai Islands. The proposition is simple: bright interiors, a calm material palette and space between the everyday and the waterfront.</p><p>We’ve laid out the facts a buyer would want to assess first — residence sizes, indicative payment stages, floor plans and risks — without representing concept data as an available offer.</p><a href="#amenities" class="text-link">Explore the lifestyle <span aria-hidden="true">↗</span></a></div></div>
      <div class="manifesto-row"><div><strong>01–03</strong><span>Bedroom concepts</span></div><div><strong>3</strong><span>Illustrative floor plans</span></div><div><strong>Dubai Islands</strong><span>Concept location only</span></div></div>
    </Container></section>

    <section class="section section--residences" id="residences" aria-labelledby="residence-heading"><Container>
      <div class="section-kicker"><span>02 / COLLECTION</span><span>ILLUSTRATIVE INVENTORY</span></div><div class="section-title-row"><div><p class="overline">A home for every chapter</p><h2 id="residence-heading" class="display-heading">Considered<br /><em>residences.</em></h2></div><p>Three hypothetical typologies, designed to demonstrate an intuitive way of comparing homes. Sizes and prices are samples, not current market listings.</p></div>
      <div class="residence-grid">
        {development.propertyTypes.map((unit, i) => <article class="residence-card"><div class="residence-art"><div class="residence-art__number">0{i+1}</div><img src={`/floorplans/${unit.plan}`} loading="lazy" alt={`Illustrative ${unit.label.toLowerCase()} layout, schematic and not to scale`} width="500" height="360" /></div><div class="residence-details"><div><span class="eyebrow-label">TYPE 0{i+1}</span><h3>{unit.label}</h3></div><p>{unit.area} <span>·</span> {unit.price}</p><a href="#floorplans" data-track="view_floor_plan" data-unit={unit.label}>View concept plan <span aria-hidden="true">↗</span></a></div></article>)}
      </div><p class="micro-disclaimer">All property areas, figures, specifications and images shown are hypothetical portfolio sample data.</p>
    </Container></section>

    <section class="section section--payment" id="payment" aria-labelledby="payment-heading"><Container>
      <div class="section-kicker section-kicker--light"><span>03 / PAYMENT</span><span>SAMPLE TERMS / NOT AN OFFER</span></div>
      <div class="payment-grid"><div><p class="overline overline--light">Designed for clarity</p><h2 id="payment-heading" class="display-heading display-heading--light">A simpler way<br />to <em>plan ahead.</em></h2><p>See how an illustrative off-plan instalment plan could be explained clearly, before discussing exact numbers with a licensed professional.</p><a href="#enquire" class="button button--light">Discuss your budget <span aria-hidden="true">↗</span></a></div><div class="payment-panel"><div class="plan-label">HYPOTHETICAL 20 / 50 / 30</div><div class="plan-bar" role="img" aria-label="20 percent booking, 50 percent during construction, 30 percent on handover"><span style="--part:20%">20%</span><span style="--part:50%">50%</span><span style="--part:30%">30%</span></div><ol class="payment-steps"><li><span>01</span><div><strong>20% <small>On booking</small></strong><p>Initial instalment in this sample.</p></div></li><li><span>02</span><div><strong>50% <small>During construction</small></strong><p>Milestone-based illustration.</p></div></li><li><span>03</span><div><strong>30% <small>On handover</small></strong><p>Illustrative final balance.</p></div></li></ol><div class="payment-footnote">Example only. Excludes taxes, registration fees, service charges, financing, and other ownership costs.</div></div></div>
    </Container></section>

    <section class="section" id="floorplans" aria-labelledby="floorplan-heading"><Container>
      <div class="section-kicker"><span>04 / FLOOR PLANS</span><span>CONCEPT DRAWINGS · NOT TO SCALE</span></div><div class="section-title-row"><div><p class="overline">A closer look</p><h2 id="floorplan-heading" class="display-heading">Plans with<br /><em>purpose.</em></h2></div><p>Preview original illustrative layouts. No dimensions or configurations have been approved for construction.</p></div>
      <div class="floorplan-list">{development.propertyTypes.map((unit,i)=><article class="floorplan-item"><div class="floorplan-item__heading"><span>0{i+1} / {unit.label}</span><span>{unit.area} · CONCEPT</span></div><img src={`/floorplans/${unit.plan}`} alt={`${unit.label} concept floor plan schematic with generic room arrangements`} loading="lazy" width="550" height="395"/><a href={`/floorplans/${unit.plan}`} target="_blank" rel="noopener" data-track="view_floor_plan" data-unit={unit.label}>Open plan <span aria-hidden="true">↗</span></a></article>)}</div>
    </Container></section>

    <section class="section section--amenities" id="amenities" aria-labelledby="amenities-heading"><Container>
      <div class="section-kicker"><span>05 / LIFESTYLE</span><span>ILLUSTRATIVE AMENITY PROGRAMME</span></div><div class="amenities-grid"><div><p class="overline">A considered everyday</p><h2 id="amenities-heading" class="display-heading">The art of<br /><em>being here.</em></h2><p>A potential amenity direction, presented as a design study rather than committed specifications.</p></div><div class="amenity-list"><div><span>01</span><strong>Waterfront promenade</strong><p>Room for a morning walk and a little less noise.</p></div><div><span>02</span><strong>Wellness studio</strong><p>A quiet, everyday space for movement.</p></div><div><span>03</span><strong>Garden courtyard</strong><p>Green spaces between home and the horizon.</p></div><div><span>04</span><strong>Residents’ lounge</strong><p>Somewhere to connect without an agenda.</p></div></div></div>
    </Container></section>

    <section class="section section--gallery" id="gallery" aria-labelledby="gallery-heading"><Container>
      <div class="section-kicker"><span>06 / GALLERY</span><span>ORIGINAL ILLUSTRATIVE ART / NO REAL PROJECT PHOTOGRAPHY</span></div><div class="section-title-row"><h2 id="gallery-heading" class="display-heading">A sense of <em>place.</em></h2><p>These are original concept illustrations created for this portfolio, not approved renders, constructed interiors or marketing images of an actual development.</p></div>
      <div class="gallery-grid">{photos.map(photo=><figure class:list={['gallery-figure',photo.cls]}><img src={photo.src} alt={photo.alt} width="1800" height="1200" loading="lazy"/><figcaption>{photo.caption}</figcaption></figure>)}</div>
    </Container></section>

    <section class="section section--location" id="location" aria-labelledby="location-heading"><Container>
      <div class="section-kicker"><span>07 / LOCATION</span><span>CONCEPT STUDY — DUBAI ISLANDS</span></div><div class="location-grid"><div><p class="overline">Between city and sea</p><h2 id="location-heading" class="display-heading">A coastal<br /><em>perspective.</em></h2><p>Dubai Islands is a real district; MARIS is not a real announced project. The location is deliberately broad and no plot, access time or proximity claim is verified.</p><div class="location-address"><span>LOCATION CONCEPT</span><strong>Dubai Islands<br />Dubai, UAE</strong></div><a href="#enquire" class="text-link">Ask a location question <span aria-hidden="true">↗</span></a></div><div class="location-map"><img src="/assets/location-diagram.svg" alt="Abstract diagram representing a coastline and island shapes; not a geographic map or property location" loading="lazy" width="900" height="700"/><span>CONCEPT DIAGRAM — NOT TO SCALE OR FOR NAVIGATION</span></div></div>
    </Container></section>

    <section class="section section--developer" id="developer" aria-labelledby="developer-heading"><Container>
      <div class="section-kicker"><span>08 / DEVELOPER</span><span>FICTIONAL ENTITY / DEMO ONLY</span></div><div class="editorial-grid"><div><p class="overline">A concept, not a claim</p><h2 id="developer-heading" class="display-heading">Made to<br /><em>demonstrate.</em></h2></div><div class="editorial-body"><p><strong>Maris Development Studio</strong> is a fictional entity created solely for this web portfolio. It has no claimed license, built projects, sales team, construction programme or investment record.</p><p>This section demonstrates where a real developer’s corporate details, past projects, approvals and verification links would appear after fact-checking.</p></div></div>
    </Container></section>

    <section class="section section--considerations" id="considerations" aria-labelledby="considerations-heading"><Container>
      <div class="section-kicker"><span>09 / BUYER CONSIDERATIONS</span><span>INFORMATIONAL · NOT FINANCIAL ADVICE</span></div><h2 id="considerations-heading" class="display-heading">Look beyond<br /><em>the brochure.</em></h2><div class="risk-grid"><article><span>01</span><h3>Actual cost of ownership</h3><p>Include taxes, registration, financing, service charges, insurance and potential maintenance, not just the headline price.</p></article><article><span>02</span><h3>Delivery and contractual risk</h3><p>Check construction status, escrow arrangements, developer approvals, contract terms and possible handover changes for real projects.</p></article><article><span>03</span><h3>Rental and exit assumptions</h3><p>Occupancy, rent levels, liquidity and market conditions vary. No rental yield, capital growth or investment return is guaranteed.</p></article></div>
    </Container></section>

    <section class="section section--faq" id="faq" aria-labelledby="faq-heading"><Container>
      <div class="section-kicker"><span>10 / QUESTIONS</span><span>THE ESSENTIAL DETAILS</span></div><div class="faq-grid"><div><h2 id="faq-heading" class="display-heading">Good questions.<br /><em>Clear answers.</em></h2></div><div class="faq-list"><details><summary>Is MARIS a real development?<span aria-hidden="true">+</span></summary><p>No. MARIS Residences and its developer are fictional demonstration brands. Pricing, schedules and layouts are examples only.</p></details><details><summary>Are the starting prices or payment plan current?<span aria-hidden="true">+</span></summary><p>No. AED 1.85M and the 20/50/30 structure are invented illustrative figures to showcase how a buyer-oriented page would present verified terms.</p></details><details><summary>Can I purchase or reserve a unit?<span aria-hidden="true">+</span></summary><p>No, there are no available units. The enquiry form demonstrates qualified lead capture and must be connected to a real licensed operator before commercial use.</p></details><details><summary>Can I download sample floor plans and a brochure?<span aria-hidden="true">+</span></summary><p>Yes. The drawings and downloadable brochure are original sample materials clearly marked as conceptual, not construction documents.</p></details><details><summary>What should I verify before a real off-plan purchase?<span aria-hidden="true">+</span></summary><p>Confirm ownership documentation, developer registration, the exact project and unit, escrow details, construction status, all fees and contractual obligations with qualified local advisers.</p></details></div></div>
    </Container></section>

    <section class="section section--enquire" id="enquire" aria-labelledby="enquire-heading"><Container>
      <div class="enquire-grid"><div class="enquire-copy"><div class="section-kicker section-kicker--light"><span>11 / CONNECT</span><span>BUYER QUALIFICATION DEMO</span></div><p class="overline overline--light">Tell us what fits</p><h2 id="enquire-heading" class="display-heading display-heading--light">Make room<br />for <em>your next step.</em></h2><p>Try the qualification experience using sample information. The form validates locally; no enquiry is delivered or stored unless a secure CRM endpoint is configured.</p><div class="enquire-secondary"><a href="/brochure/maris-sample-brochure.pdf" download data-track="download_brochure">Download concept brochure <span aria-hidden="true">↓</span></a><a href={waHref} target={waNumber ? "_blank" : undefined} rel={waNumber ? "noopener noreferrer" : undefined} data-track={waNumber ? "click_whatsapp" : "start_form"} data-prefer-whatsapp={!waNumber ? "true" : undefined}>Request WhatsApp contact <span aria-hidden="true">↗</span></a></div></div>
      <form class="lead-form" method="post" action="/api/lead" data-lead-form data-endpoint={import.meta.env.PUBLIC_LEAD_ENDPOINT || ''} novalidate>
        <div class="form-heading"><p>01 / YOUR PREFERENCES</p><h3>Explore your options.</h3><span>All fields marked * are required.</span></div>
        <div class="form-errors" data-error-summary role="alert" tabindex="-1" hidden></div>
        <div class="form-fields">
          <div class="field"><label for="budget">Budget range <span>*</span></label><select name="budget" id="budget" required aria-describedby="budget-error"><option value="">Choose your budget</option><option value="under-1.5m">Under AED 1.5M</option><option value="1.5-2.5m">AED 1.5M–2.5M</option><option value="2.5-4m">AED 2.5M–4M</option><option value="4m-plus">AED 4M+</option><option value="undecided">Not sure yet</option></select><small id="budget-error" data-error-for="budget" class="field-error"></small></div>
          <div class="field"><label for="property_type">Property type <span>*</span></label><select name="property_type" id="property_type" required aria-describedby="property_type-error"><option value="">Choose a residence</option><option value="1-bedroom">1 bedroom</option><option value="2-bedroom">2 bedrooms</option><option value="3-bedroom">3 bedrooms</option><option value="undecided">Open to options</option></select><small id="property_type-error" data-error-for="property_type" class="field-error"></small></div>
          <div class="field"><label for="purpose">Purchase purpose <span>*</span></label><select name="purpose" id="purpose" required aria-describedby="purpose-error"><option value="">Choose a purpose</option><option value="own-use">Personal use</option><option value="investment">Investment</option><option value="both">Both</option></select><small id="purpose-error" data-error-for="purpose" class="field-error"></small></div>
          <div class="field"><label for="timeline">Purchase timeline <span>*</span></label><select name="timeline" id="timeline" required aria-describedby="timeline-error"><option value="">Choose a timeline</option><option value="now">As soon as possible</option><option value="1-3-months">1–3 months</option><option value="3-6-months">3–6 months</option><option value="exploring">Just exploring</option></select><small id="timeline-error" data-error-for="timeline" class="field-error"></small></div>
          <div class="field field--wide"><label for="financing">How would you purchase? <span>*</span></label><select name="financing" id="financing" required aria-describedby="financing-error"><option value="">Select financing</option><option value="cash">Cash</option><option value="mortgage">Mortgage</option><option value="undecided">Undecided</option></select><small id="financing-error" data-error-for="financing" class="field-error"></small></div>
          <div class="form-subheading field--wide">02 / YOUR DETAILS</div>
          <div class="field field--wide"><label for="name">Your name <span>*</span></label><input name="name" id="name" type="text" autocomplete="name" minlength="2" maxlength="120" placeholder="Full name" required aria-describedby="name-error"/><small id="name-error" data-error-for="name" class="field-error"></small></div>
          <div class="field"><label for="email">Email address</label><input name="email" id="email" type="email" autocomplete="email" maxlength="180" placeholder="you@example.com" aria-describedby="email-error"/><small id="email-error" data-error-for="email" class="field-error"></small></div>
          <div class="field"><label for="phone">Phone (country code)</label><input name="phone" id="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="22" placeholder="+971 ..." aria-describedby="phone-error"/><small id="phone-error" data-error-for="phone" class="field-error"></small></div>
          <p class="field-hint field--wide">Provide at least an email address or phone number.</p>
          <div class="field field--wide"><label id="contact-label" for="form-contact-preference">Preferred contact channel</label><select id="form-contact-preference" name="contact_preference"><option value="email">Email</option><option value="phone">Phone</option><option value="whatsapp">WhatsApp</option></select></div>
          <div class="trap" aria-hidden="true"><label for="website">Leave this field blank</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
          <div class="field--wide consent"><input type="checkbox" id="consent" name="consent" required aria-describedby="consent-error"/><label for="consent">I agree to be contacted about this enquiry and understand that, when a real submission endpoint is configured, my details may be processed for this purpose. See the <a href="/privacy/">privacy notice</a>. <span>*</span></label><small id="consent-error" data-error-for="consent" class="field-error"></small></div>
          <div class="field--wide"><button class="form-submit" type="submit" data-submit>Submit enquiry <span aria-hidden="true">↗</span></button><p class="form-status" role="status" aria-live="polite" data-form-status>Demo mode. No information will be submitted until a secure endpoint is configured.</p></div>
        </div>
      </form></div>
    </Container></section>
  </main>
  <footer class="site-footer" id="disclosure"><Container><div class="footer-top"><a href="/" class="wordmark wordmark--footer">MARIS<span class="wordmark-dot">.</span><small>R E S I D E N C E S</small></a><p>A fictional off-plan real-estate web concept. Built to demonstrate thoughtful search intent, accessible UX and ethical lead qualification.</p></div><div class="footer-bottom"><span>© {new Date().getFullYear()} MARIS · Fictional portfolio sample</span><nav aria-label="Footer links"><a href="#overview">Overview</a><a href="#faq">FAQ</a><a href="/privacy/">Privacy</a><a href="#main">Back to top ↑</a></nav></div><p class="footer-disclosure">Important: no inventory, developer approval, brokerage representation, price, financing arrangement, completion date or performance result on this website is genuine or available for purchase.</p></Container></footer>
  <div class="mobile-sticky" aria-label="Quick enquiry actions"><a href="/brochure/maris-sample-brochure.pdf" download data-track="download_brochure">Brochure ↓</a><a href="#enquire" data-track="start_form">Enquire ↗</a></div>
</Base>
