---
import Base from '../layouts/Base.astro';
import { development } from '../data/development';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const waNumber = String(import.meta.env.PUBLIC_WHATSAPP_NUMBER || '').replace(/\D/g,'');
const waHref = waNumber ? `https://wa.me/${waNumber}?text=${encodeURIComponent('Hello. I would like details about MARIS Residences. I understand this is a fictional portfolio demonstration.')}` : '#form-contact-preference';
const units = development.propertyTypes.map((u,i) => ({...u, id:String(u.bedrooms), code:`0${i+1}`, image:`residence-${i+1}.webp`, plan:`${i+1}-bedroom-concept.svg`, pdf:`${i+1}-bedroom-concept.pdf` }));
const images = [
 {id:'waterfront',src:'waterfront.webp',alt:'Fictional MARIS residence overlooking waterfront, original concept rendering',cat:'exterior',label:'Waterfront view'},
 {id:'overview',src:'overview.webp',alt:'Oblique view of the fictional MARIS curving-balcony waterfront development',cat:'exterior',label:'The architecture'},
 {id:'facade',src:'facade.webp',alt:'Close view of curved balconies and limestone-style facade of fictional MARIS',cat:'exterior',label:'Facade rhythm'},
 {id:'one',src:'residence-1.webp',alt:'Concept one-bedroom MARIS living and dining interior with coastal palette',cat:'interiors',label:'One-bedroom living'},
 {id:'two',src:'residence-2.webp',alt:'Fictional two-bedroom interior with spacious lounge and dining area',cat:'interiors',label:'Two-bedroom living'},
 {id:'three',src:'residence-3.webp',alt:'Fictional three-bedroom residence with generous waterfront living space',cat:'interiors',label:'Three-bedroom living'},
 {id:'pool',src:'pool.webp',alt:'Illustrative landscaped resort pool adjacent to fictional MARIS podium',cat:'amenities',label:'Waterfront pool'},
 {id:'arrival',src:'arrival.webp',alt:'Concept MARIS arrival lobby with natural stone and warm timber finishes',cat:'amenities',label:'Arrival lobby'},
 {id:'garden',src:'garden.webp',alt:'Concept planted promenade and garden courtyard at MARIS',cat:'amenities',label:'The landscaped grounds'},
 {id:'lounge',src:'lounge.webp',alt:'Concept shared lounge with neutral furnishings and waterfront outlook',cat:'amenities',label:'Residents lounge'},
 {id:'podium',src:'podium-detail.webp',alt:'Concept pool and terrace perspective at the MARIS residential podium',cat:'amenities',label:'Podium terrace'},
 {id:'detail',src:'facade-close.webp',alt:'Close architectural visualization of rounded balconies on MARIS',cat:'exterior',label:'Architectural detail'}
];
const amenities = [
 {name:'Waterside pool',text:'A planted pool terrace at the edge of the promenade.',image:'pool.webp'},
 {name:'Arrival lobby',text:'Warm stone, timber details and a welcoming first impression.',image:'arrival.webp'},
 {name:'Landscaped walks',text:'Shaded paths with native-inspired coastal planting.',image:'garden.webp'},
 {name:'Residents lounge',text:'A calm place to meet, work or unwind.',image:'lounge.webp'},
 {name:'Garden podium',text:'Outdoor rooms set between the residences and waterfront.',image:'podium-detail.webp'},
 {name:'Private terraces',text:'Outdoor space shaped by the building’s flowing facade.',image:'facade.webp'}
];
const faq = [
 ['Is MARIS Residences a real development?','No. MARIS Residences and Maris Development Studio are fictional identities created to demonstrate a real-estate project website. There is no actual inventory or developer approval.'],
 ['Are the prices, payment plan and handover date real?','No. AED 1.85M starting price, the 20/50/30 schedule and Q4 2029 are illustrative sample figures only.'],
 ['Are the floor plans construction drawings?','No. The three original plans are conceptual diagrams, not to scale and not approved or measured construction plans.'],
 ['Can I download the brochure without giving my contact details?','Yes. The sample brochure and floor plan PDFs are available directly, without submitting the demonstration form.'],
 ['How should I evaluate a real off-plan purchase?','Verify project registration, developer and escrow details, payment terms, delivery milestones, service charges and contract documents with qualified local advisers.'],
 ['Does the enquiry form submit real leads?','Only when a valid secure destination is configured. Otherwise the form validates inputs and clearly explains that no personal information was transmitted or stored.']
];
---
<Base title="MARIS Residences | Dubai Islands Off-Plan Concept, Plans & Prices" description="Explore a fictional Dubai Islands residential project with illustrative 1–3 bedroom prices, 20/50/30 payment plan, original floor plans, brochure and buyer qualification demo.">
<div class="m-page" id="top">
  <div class="m-demo"><div class="m-wrap"><span class="m-demo-dot" aria-hidden="true"></span><span>PORTFOLIO CONCEPT · FICTIONAL PROJECT · ALL PRICES & VISUALS ILLUSTRATIVE</span><a href="#disclosure">Details</a></div></div>
  <header class="m-header"><div class="m-wrap m-header-in">
    <a class="m-logo" href={base} aria-label="MARIS Residences homepage">MARIS<span>RESIDENCES</span></a>
    <nav class="m-nav" aria-label="Main navigation"><a href="#overview">Overview</a><a href="#residences">Residences</a><a href="#floorplans">Floor plans</a><a href="#payment">Payment plan</a><a href="#amenities">Amenities</a><a href="#location">Location</a></nav>
    <a class="m-header-cta" href="#enquire" data-track="start_form">Enquire <span aria-hidden="true">↗</span></a>
    <details class="m-mobile-menu"><summary aria-label="Open navigation"><span class="m-menu-bars" aria-hidden="true">☰</span> Menu</summary><nav aria-label="Mobile navigation"><a href="#overview">Overview</a><a href="#residences">Residences</a><a href="#floorplans">Floor plans</a><a href="#payment">Payment plan</a><a href="#amenities">Amenities</a><a href="#location">Location</a><a href="#enquire">Enquire</a></nav></details>
  </div></header>
  <main id="main">
    <section class="hero m-hero" aria-labelledby="m-hero-title"><div class="m-hero-grid">
      <div class="m-hero-copy"><p class="m-eyebrow"><span class="m-dash"></span> DUBAI ISLANDS · FICTIONAL PROJECT</p><h1 id="m-hero-title">MARIS<br/><span>Residences.</span></h1><p class="m-hero-subhead">Waterfront living, clearly considered.</p><p class="m-hero-desc">An original coastal residential concept with thoughtful layouts, gentle materials and a new perspective on everyday life.</p>
        <div class="m-hero-price"><span>ILLUSTRATIVE STARTING PRICE</span><strong>From AED 1.85M</strong><small>Sample only · Not available for purchase</small></div>
        <div class="m-actions"><a class="m-btn m-btn-primary" href="#floorplans" data-track="view_floor_plan">Get floor plans <span aria-hidden="true">↗</span></a><a class="m-btn m-btn-outline" href={asset('brochure/maris-concept-brochure.pdf')} download data-track="download_brochure">Sample brochure <span aria-hidden="true">↓</span></a></div>
        <span class="m-hero-counter">01 / 12 &nbsp; · &nbsp; A COASTAL IDEA</span>
      </div>
      <div class="m-hero-media"><picture><source media="(max-width: 600px)" srcset={asset('assets/maris/hero-mobile.webp')}/><img src={asset('assets/maris/hero-desktop.webp')} alt="Original visualization of fictional MARIS Residences, a cream-colored waterfront building with rounded balconies and coastal landscaping" width="1600" height="900" fetchpriority="high" decoding="async"/></picture><div class="m-photo-credit">MARIS / ORIGINAL ARCHITECTURAL CONCEPT <span>NOT A REAL BUILDING</span></div></div>
    </div></section>
    <section class="m-facts" aria-label="Development at a glance"><div class="m-wrap m-fact-grid"><div><span>STARTING PRICE</span><strong>AED 1.85M</strong><small>Sample</small></div><div><span>RESIDENCE TYPES</span><strong>1 – 3 BR</strong><small>Concept layouts</small></div><div><span>PAYMENT PLAN</span><strong>20 / 50 / 30</strong><small>Illustrative</small></div><div><span>HANDOVER</span><strong>Q4 2029</strong><small>Fictional date</small></div></div></section>

    <section id="overview" class="m-section m-overview" aria-labelledby="m-overview-title"><div class="m-wrap"><div class="m-section-label"><span>01 / THE PROJECT</span><span>A DIFFERENT PERSPECTIVE</span></div><div class="m-overview-grid"><div class="m-overview-copy"><p class="m-kicker">MARIS RESIDENCES</p><h2 id="m-overview-title" class="m-h2">Space to live <em>a little slower.</em></h2><p>MARIS is a fictional residence concept exploring the meeting point of architecture, water and everyday comfort on Dubai Islands.</p><p>From expansive glazing to flowing terraces and softly planted spaces, every element follows the same original architectural language.</p><a class="m-link" href="#residences">Discover the residences <span aria-hidden="true">↗</span></a></div><figure class="m-overview-visual"><img src={asset('assets/maris/overview.webp')} loading="lazy" width="1500" height="1000" alt="Alternative waterfront viewpoint of the fictional MARIS residential complex"/><figcaption>02 / AN ORIGINAL DEVELOPMENT CONCEPT</figcaption></figure></div></div></section>

    <section id="residences" class="m-section m-residences" aria-labelledby="m-res-title"><div class="m-wrap"><div class="m-section-label"><span>02 / RESIDENCES</span><span>THREE WAYS TO LIVE</span></div><div class="m-heading-row"><div><p class="m-kicker">THE COLLECTION</p><h2 id="m-res-title" class="m-h2">Find your <em>space.</em></h2></div><p>Three imaginary residence types, brought to life through original interiors and clear sample specifications.</p></div><div class="m-res-grid">{units.map((u)=><article class="m-unit"><div class="m-unit-image"><img src={asset(`assets/maris/${u.image}`)} alt={`Original fictional MARIS ${u.bedrooms}-bedroom residential interior concept; not an available unit`} loading="lazy" width="1200" height="900"/><span>CONCEPT / 0{u.bedrooms}</span></div><div class="m-unit-info"><h3>{u.label} residence</h3><p>{u.area}<span> · </span>{u.price} <small>sample</small></p><a href="#floorplans" data-select-plan={u.id} data-track="view_floor_plan" data-unit={u.label}>Explore floor plan <span aria-hidden="true">↗</span></a></div></article>)}</div><p class="m-footnote">All unit areas, prices, interiors and specifications are hypothetical examples for this portfolio website.</p></div></section>

    <section id="floorplans" class="m-section m-floorplans" aria-labelledby="m-floor-title"><div class="m-wrap"><div class="m-section-label"><span>03 / FLOOR PLANS</span><span>ORIGINAL CONCEPT DIAGRAMS</span></div><div class="m-heading-row"><div><p class="m-kicker">LAYOUT COLLECTION</p><h2 id="m-floor-title" class="m-h2">A clear view <em>of home.</em></h2></div><p>Explore practical layouts without mistaking conceptual diagrams for approved construction plans.</p></div>
    <div class="m-plan-tabs" role="tablist" aria-label="Choose residence floor plan">{units.map((u,i)=><button type="button" role="tab" aria-controls={`plan-${u.id}`} id={`tab-${u.id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?'0':'-1'} data-plan-tab={u.id}>{u.bedrooms} BEDROOM</button>)}</div>
    {units.map((u,i)=><div class="m-plan-panel" id={`plan-${u.id}`} role="tabpanel" aria-labelledby={`tab-${u.id}`} data-plan-panel={u.id} hidden={i!==0}><div class="m-plan-image"><img src={asset(`floorplans/${u.plan}`)} alt={`Illustrative ${u.bedrooms}-bedroom MARIS floor plan showing room arrangement, not to scale`} loading="lazy" width="1100" height="760"/></div><div class="m-plan-copy"><span class="m-eyebrow">RESIDENCE TYPE 0{u.bedrooms}</span><h3>{u.label} residence</h3><dl><div><dt>Bedrooms</dt><dd>{u.bedrooms}</dd></div><div><dt>Illustrative area</dt><dd>{u.area}</dd></div><div><dt>Indicative price</dt><dd>{u.price}</dd></div><div><dt>Plan status</dt><dd>Concept / not to scale</dd></div></dl><a class="m-btn m-btn-primary" href={asset(`floorplans/${u.pdf}`)} download data-track="download_brochure" data-unit={u.label}>Download floor plan PDF <span aria-hidden="true">↓</span></a><a class="m-link" href="#enquire" data-select-unit={u.id}>Ask about this layout <span aria-hidden="true">↗</span></a><p class="m-footnote">Room sizes and dimensions are illustrative; not issued for construction.</p></div></div>)}
    </div></section>

    <section id="payment" class="m-section m-payment" aria-labelledby="m-payment-title"><div class="m-wrap"><div class="m-section-label"><span>04 / PAYMENT PLAN</span><span>ILLUSTRATIVE TERMS ONLY</span></div><div class="m-payment-grid"><div><p class="m-kicker">THE PAYMENT STRUCTURE</p><h2 id="m-payment-title" class="m-h2">Plan with <em>perspective.</em></h2><p>A simple example of how off-plan instalments can be presented. Actual agreements may contain additional fees, dates and contractual obligations.</p><a href="#enquire" class="m-btn m-btn-light" data-track="start_form">Discuss your budget <span aria-hidden="true">↗</span></a></div><div class="m-payment-stages"><div class="m-payment-line" role="img" aria-label="20 percent booking, 50 percent during construction, 30 percent on handover"><span style="width:20%">20%</span><span style="width:50%">50%</span><span style="width:30%">30%</span></div><div class="m-payment-list"><div><span>01</span><strong>20%</strong><p>On booking</p></div><div><span>02</span><strong>50%</strong><p>During construction</p></div><div><span>03</span><strong>30%</strong><p>At handover</p></div></div><p class="m-footnote">Fictional payment terms. Q4 2029 is an illustrative handover date, not a completion prediction.</p></div></div></div></section>

    <section id="amenities" class="m-section m-amenities" aria-labelledby="m-amen-title"><div class="m-wrap"><div class="m-section-label"><span>05 / THE EXPERIENCE</span><span>AMENITY CONCEPTS</span></div><div class="m-heading-row"><div><p class="m-kicker">EVERYDAY BY THE WATER</p><h2 id="m-amen-title" class="m-h2">Room for <em>more living.</em></h2></div><p>From poolside mornings to shaded walks and quiet interiors: imagined details of one consistent coastal environment.</p></div><div class="m-amenity-grid">{amenities.map((a,i)=><figure class:list={['m-amenity',i===0?'m-amenity-featured':'']}><img src={asset(`assets/maris/${a.image}`)} alt={`Original fictional MARIS amenity visual: ${a.name.toLowerCase()}`} loading="lazy" width="1100" height="700"/><figcaption><strong>{a.name}</strong><span>{a.text}</span></figcaption></figure>)}</div></div></section>

    <section id="gallery" class="m-section m-gallery" aria-labelledby="m-gallery-title"><div class="m-wrap"><div class="m-section-label"><span>06 / IMAGE GALLERY</span><span>ORIGINAL CONCEPT VISUALS</span></div><div class="m-heading-row"><div><p class="m-kicker">SEE IT FROM EVERY ANGLE</p><h2 id="m-gallery-title" class="m-h2">A closer <em>look.</em></h2></div><p>Architectural visualizations of a fictional development. These do not show real completed buildings.</p></div><div class="m-gallery-filters" role="group" aria-label="Gallery categories"><button type="button" data-gallery-filter="all" aria-pressed="true">All images</button><button type="button" data-gallery-filter="exterior" aria-pressed="false">Exteriors</button><button type="button" data-gallery-filter="interiors" aria-pressed="false">Interiors</button><button type="button" data-gallery-filter="amenities" aria-pressed="false">Amenities</button></div><div class="m-gallery-grid">{images.map((im,i)=><button type="button" class:list={['m-gallery-photo',i===0?'m-gallery-lead':'']} data-gallery-item data-category={im.cat} data-gallery-index={i} aria-label={`View photo: ${im.label}`}><img src={asset(`assets/maris/${im.src}`)} alt={im.alt} loading="lazy" width="1200" height="900"/><span>{im.label} <span aria-hidden="true">↗</span></span></button>)}</div><p class="m-footnote">Photos are original AI-generated architectural concepts; additional detail scenes derive from the MARIS master-reference. No real property is represented.</p></div></section>

    <section id="location" class="m-section m-location" aria-labelledby="m-location-title"><div class="m-wrap"><div class="m-section-label"><span>07 / LOCATION</span><span>AREA CONCEPT ONLY</span></div><div class="m-location-grid"><div><p class="m-kicker">DUBAI ISLANDS, DUBAI</p><h2 id="m-location-title" class="m-h2">A place between <em>city and sea.</em></h2><p>Dubai Islands is a real coastal district used here solely as the setting for this imagined development. MARIS has no verified plot, registered address or travel-time claims.</p><ul><li>Island district context</li><li>Waterfront environment</li><li>Concept coastal promenade</li><li>No specific development plot asserted</li></ul></div><figure class="m-location-map"><img src={asset('assets/maris/location-context.svg')} width="1200" height="850" loading="lazy" alt="Illustrative, non-navigational coastal context diagram labelled Dubai Islands; no MARIS project plot shown"/><figcaption>Illustrative orientation only — not a geographic plan or mapped site location.</figcaption></figure></div></div></section>

    <section id="investment" class="m-section m-investment" aria-labelledby="m-invest-title"><div class="m-wrap"><div class="m-section-label"><span>08 / INVESTMENT CONSIDERATIONS</span><span>BEYOND THE BROCHURE</span></div><div class="m-heading-row"><div><p class="m-kicker">A FULLER PICTURE</p><h2 id="m-invest-title" class="m-h2">Know what <em>to consider.</em></h2></div><p>These prompts are general educational reminders, not project-specific investment advice or promised returns.</p></div><div class="m-risk-grid"><article><span>01 / COSTS</span><h3>Ownership is more than the price.</h3><p>Consider registration, financing, service charges, insurance, maintenance and ongoing administration.</p></article><article><span>02 / DELIVERY</span><h3>Review milestones and contracts.</h3><p>For any actual purchase, independently verify registration, escrow safeguards, completion status and contractual remedies.</p></article><article><span>03 / RETURNS</span><h3>Every market has uncertainty.</h3><p>Rent, occupancy, resale liquidity and price trends vary. No specific capital growth or income is guaranteed.</p></article></div></div></section>

    <section id="developer" class="m-section m-developer" aria-labelledby="m-dev-title"><div class="m-wrap"><div class="m-dev-grid"><img src={asset('assets/maris/facade.webp')} loading="lazy" width="1300" height="900" alt="Close architectural rendering of fictional MARIS curved balconies and facade"/><div><p class="m-kicker">09 / THE STUDIO</p><h2 id="m-dev-title" class="m-h2">An idea, <em>not an operator.</em></h2><p>Maris Development Studio is a fictional portfolio brand. This website illustrates how a project page might present architecture, residences and buyer information.</p><p>It does not represent a registered developer, brokerage, actual construction programme or sale of real estate.</p></div></div></div></section>

    <section id="faq" class="m-section m-faq" aria-labelledby="m-faq-title"><div class="m-wrap"><div class="m-section-label"><span>10 / COMMON QUESTIONS</span><span>TRANSPARENT BY DESIGN</span></div><div class="m-faq-grid"><h2 id="m-faq-title" class="m-h2">Good questions.<br/><em>Clear answers.</em></h2><div class="m-faq-items">{faq.map(([q,a])=><details><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}</div></div></div></section>

    <section id="enquire" class="m-section m-enquire" aria-labelledby="m-enquire-title"><div class="m-wrap"><div class="m-section-label"><span>11 / BUYER ENQUIRY</span><span>QUALIFICATION DEMONSTRATION</span></div><div class="m-enquire-grid"><div class="m-enquire-copy"><p class="m-kicker">TELL US WHAT FITS</p><h2 id="m-enquire-title" class="m-h2">Explore your <em>next step.</em></h2><p>Try the sample enquiry journey. The form validates locally; no personal data will be sent or saved unless a secure submission endpoint is configured.</p><a href={asset('brochure/maris-concept-brochure.pdf')} download class="m-link m-link-light" data-track="download_brochure">Download sample brochure ↓</a><a href={waHref} class="m-link m-link-light" target={waNumber?'_blank':undefined} rel={waNumber?'noopener noreferrer':undefined} data-track={waNumber?'click_whatsapp':'start_form'} data-prefer-whatsapp={!waNumber?'true':undefined}> {waNumber?'Ask on WhatsApp ↗':'Prefer WhatsApp contact? ↗'} </a></div>
    <form class="m-lead-form" method="post" action={import.meta.env.PUBLIC_LEAD_ENDPOINT || 'https://example.invalid/not-connected'} data-lead-form data-endpoint={import.meta.env.PUBLIC_LEAD_ENDPOINT || ''} novalidate><h3>Your buying preferences</h3><p class="m-form-intro">Fields marked * are required. All information entered here is demo data unless a secure endpoint is configured.</p><div class="form-errors m-error-summary" data-error-summary role="alert" tabindex="-1" hidden></div><div class="m-form-grid">
      <div class="m-field"><label for="budget">Budget range *</label><select id="budget" name="budget" required aria-describedby="budget-error"><option value="">Select a range</option><option value="under-1.5m">Under AED 1.5M</option><option value="1.5-2.5m">AED 1.5–2.5M</option><option value="2.5-4m">AED 2.5–4M</option><option value="4m-plus">AED 4M+</option><option value="undecided">Not sure yet</option></select><small id="budget-error" data-error-for="budget" class="field-error"></small></div>
      <div class="m-field"><label for="property_type">Residence type *</label><select id="property_type" name="property_type" required aria-describedby="property_type-error"><option value="">Choose a residence</option><option value="1-bedroom">1 bedroom</option><option value="2-bedroom">2 bedrooms</option><option value="3-bedroom">3 bedrooms</option><option value="undecided">Open to options</option></select><small id="property_type-error" data-error-for="property_type" class="field-error"></small></div>
      <div class="m-field"><label for="purpose">Purchase purpose *</label><select id="purpose" name="purpose" required aria-describedby="purpose-error"><option value="">Select a purpose</option><option value="own-use">Personal use</option><option value="investment">Investment</option><option value="both">Both</option></select><small id="purpose-error" data-error-for="purpose" class="field-error"></small></div>
      <div class="m-field"><label for="timeline">Purchase timeline *</label><select id="timeline" name="timeline" required aria-describedby="timeline-error"><option value="">Select timeline</option><option value="now">As soon as possible</option><option value="1-3-months">1–3 months</option><option value="3-6-months">3–6 months</option><option value="exploring">Just exploring</option></select><small id="timeline-error" data-error-for="timeline" class="field-error"></small></div>
      <div class="m-field m-wide"><label for="financing">Purchase method *</label><select id="financing" name="financing" required aria-describedby="financing-error"><option value="">Select a method</option><option value="cash">Cash</option><option value="mortgage">Mortgage</option><option value="undecided">Undecided</option></select><small id="financing-error" data-error-for="financing" class="field-error"></small></div>
      <p class="m-form-divider m-wide">YOUR CONTACT DETAILS</p>
      <div class="m-field m-wide"><label for="name">Full name *</label><input id="name" name="name" autocomplete="name" type="text" minlength="2" maxlength="120" placeholder="Your full name" required aria-describedby="name-error"/><small id="name-error" data-error-for="name" class="field-error"></small></div>
      <div class="m-field"><label for="email">Email address</label><input id="email" name="email" autocomplete="email" type="email" maxlength="180" placeholder="name@example.com" aria-describedby="email-error"/><small id="email-error" data-error-for="email" class="field-error"></small></div>
      <div class="m-field"><label for="phone">Phone with country code</label><input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="22" placeholder="+971 …" aria-describedby="phone-error"/><small id="phone-error" data-error-for="phone" class="field-error"></small></div>
      <p class="m-hint m-wide">Provide at least an email address or phone number.</p>
      <div class="m-field m-wide"><label for="contact-preference">Preferred contact channel</label><select id="form-contact-preference" name="contact_preference"><option value="email">Email</option><option value="phone">Phone</option><option value="whatsapp">WhatsApp</option></select></div>
      <div class="trap" aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" autocomplete="off" tabindex="-1"/></div>
      <div class="m-consent m-wide"><input type="checkbox" name="consent" id="consent" required aria-describedby="consent-error"/><label for="consent">I consent to being contacted about this enquiry if a real secure endpoint is configured, and have read the <a href={asset('privacy/')}>privacy notice</a>. *</label><small id="consent-error" data-error-for="consent" class="field-error"></small></div>
      <div class="m-wide"><button type="submit" class="m-submit" data-submit>Submit sample enquiry <span aria-hidden="true">↗</span></button><p class="form-status m-status" role="status" aria-live="polite" data-form-status>Demo mode: no information will be submitted until a secure endpoint is configured.</p></div>
    </div></form></div></div></section>
