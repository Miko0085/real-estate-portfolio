---
import '@estate/design-tokens';
import '../styles/global.css';
import Seo from '@estate/seo/Seo.astro';
import { webPageSchema, breadcrumbs } from '@estate/structured-data';
interface Props { title:string; description:string; path?:string; }
const { title, description, path='/' } = Astro.props;
const rootOrigin = Astro.site || new URL('https://example.com/');
const base = new URL(import.meta.env.BASE_URL, rootOrigin);
const canonical = new URL(path.replace(/^\/+/, ''), base).toString();
const image = new URL('og-cover.png',base).toString();
const index = import.meta.env.PUBLIC_INDEX_SITE === 'true' && Boolean(import.meta.env.PUBLIC_SITE_URL);
const jsonLd = [webPageSchema({name:title,description,url:canonical}),breadcrumbs([{name:'Home',url:new URL('.',base).toString()}])];
---
<!doctype html>
<html lang="en" data-analytics-enabled={import.meta.env.PUBLIC_ANALYTICS_ENABLED === 'true' ? 'true':'false'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#173b3d" />
  <meta name="color-scheme" content="light" />
  <Seo title={title} description={description} canonical={canonical} image={image} noindex={!index} jsonLd={jsonLd} />
  <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <slot />
  <script>import '../scripts/site.ts';</script>
</body>
</html>
