---
import Layout from '@estate/ui/PortfolioLayout.astro';
import {areas,properties,type EstateArea,formatPrice} from '../../data/inventory';import {nav} from '../../data/nav';
import '../../styles/global.css';
export function getStaticPaths(){return areas.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props as {item:EstateArea};const p=import.meta.env.BASE_URL;const related=properties.filter(x=>x.areaSlug===item.slug);
---
<Layout title={`${item.name} Area Guide | ATELIER Estates`} description={`Explore ${item.name} through fictional real-estate concepts and example homes.`} brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href={p}>Home</a><span>/</span><a href={`${p}areas/`}>Areas</a><span>/</span><span>{item.name}</span></nav><section class="page-heading container"><p class="eyebrow">NEIGHBOURHOOD / EDITORIAL</p><h1>{item.name}<span class="period">.</span></h1><p>{item.intro}</p></section><div class="full-image container"><img src={`${p}assets/${item.image}`} alt={`Original illustrative scene inspired by ${item.name}; not a documented view`} width="1200" height="675" fetchpriority="high" /></div><section class="container detail-body"><article><p class="eyebrow">THE AREA</p><h2>Discover the character.</h2><p>{item.character}. This sample editorial area guide shows a way to organize local context without claiming current market statistics.</p><p>Before purchasing, verify transport, amenities, service charges, building rules and transaction costs independently.</p></article><aside class="specification"><p class="eyebrow">EXPLORE THE AREA</p><p>{related.length} fictional property concepts included for this area.</p><a class="solid-button" href={`${p}properties/?area=${item.slug}`}>View sample properties ↗</a></aside></section><section class="container detail-related"><h2>Residences in {item.name}</h2><div class="property-grid">{related.map(x=><a href={`${p}properties/${x.slug}/`} class="property-card"><img src={`${p}assets/${x.image}`} alt={`Fictional illustration of ${x.name}`} width="1200" height="675" loading="lazy"/><div class="property-text"><span>{x.type}</span><h3>{x.name}</h3><p>{formatPrice(x.price)}</p></div></a>)}</div></section>
</Layout>
