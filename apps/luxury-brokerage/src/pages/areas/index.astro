---
import Layout from '@estate/ui/PortfolioLayout.astro';
import {areas} from '../../data/inventory';import {nav} from '../../data/nav';
import '../../styles/global.css';const p=import.meta.env.BASE_URL;
---
<Layout title="Neighbourhoods | ATELIER Estates — Demo" description="Explore fictional brokerage area guides covering Palm Jumeirah, Dubai Hills and Dubai Marina." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <section class="page-heading container"><p class="eyebrow">A SENSE OF PLACE</p><h1>Areas<span class="period">.</span></h1><p>A neighbourhood is as important as a floor plan. These editorial area notes contain no market statistics.</p></section><section class="container area-directory">{areas.map((a,i)=><a class="area-directory-row" href={`${p}areas/${a.slug}/`}><span>0{i+1}</span><img src={`${p}assets/${a.image}`} alt={`Original conceptual illustration associated with ${a.name}`} width="1200" height="675" loading="lazy"/><div><h2>{a.name}</h2><p>{a.intro}</p><strong>View the neighbourhood ↗</strong></div></a>)}</section>
</Layout>
