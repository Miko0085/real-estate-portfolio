---
import Layout from '@estate/ui/PortfolioLayout.astro';
import { properties, areas, developments,formatPrice } from '../data/inventory';
import {nav} from '../data/nav';
import '../styles/global.css';
const p=import.meta.env.BASE_URL;
---
<Layout title="ATELIER Estates | Curated Properties in Dubai — Demo" description="Explore a fictional luxury brokerage with sample property listings, developments and area guides." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <section class="home-hero"><div class="hero-visual"><img src={`${p}assets/brokerage-noir.webp`} alt="Original AI-generated monochrome urban penthouse study; fictional, not a real listing" width="836" height="470" fetchpriority="high"/><span>ATELIER / CITY NOIR · FICTIONAL CONCEPT</span></div><div class="hero-overlay"><div class="container hero-content"><p class="eyebrow">A COLLECTION OF PLACES / DUBAI</p><h1>Property, with<br><em>perspective.</em></h1><p>Distinctive addresses. Thoughtful spaces. A more considered way to explore a home.</p><a class="outline-light" href={`${p}properties/`}>Discover the collection <span aria-hidden="true">↗</span></a></div></div></section>
 <section class="intro-section container"><p class="eyebrow">01 / OUR COLLECTION</p><div class="intro-grid"><h2>Find the place<br>that feels <em>different.</em></h2><p>Explore a curated, fictional catalogue designed to demonstrate how premium homes can be discovered by location, lifestyle and detail. Listings and figures are illustrative.</p></div></section>
 <section class="property-section container" id="featured"><div class="section-header"><h2>Selected residences</h2><a href={`${p}properties/`}>All properties <span aria-hidden="true">↗</span></a></div><div class="property-grid">{properties.slice(0,3).map(item=><a class="property-card" href={`${p}properties/${item.slug}/`} data-track="view_property"><img src={`${p}assets/${item.image}`} alt={`Original fictional architectural concept artwork for ${item.name}`} width="1200" height="675" loading="lazy"/><span class="card-index">{item.status} / SAMPLE</span><div class="property-text"><span>{item.area}</span><h3>{item.name}</h3><p>{formatPrice(item.price)} <span>· {item.bedrooms} bedrooms</span></p></div></a>)}</div></section>
 <section class="editorial-band"><div class="container editorial-inner"><p class="eyebrow">02 / A DIFFERENT KIND OF ADDRESS</p><h2>Space to live<br><em>beautifully.</em></h2><p>From the energy of the marina to the quiet of garden communities, each neighbourhood tells a different story.</p><a href={`${p}areas/`}>Explore neighbourhoods ↗</a></div></section>
 <section class="container areas-section"><div class="section-header"><h2>Places worth exploring</h2><a href={`${p}areas/`}>All areas ↗</a></div><div class="areas-grid">{areas.map(item=><a href={`${p}areas/${item.slug}/`} class="area-card"><img src={`${p}assets/${item.image}`} alt={`Concept artwork representing ${item.name}`} width="1200" height="675" loading="lazy"/><div><h3>{item.name}</h3><p>{item.character}</p></div></a>)}</div></section>
 <section class="container development-preview"><div><p class="eyebrow">03 / NEW DEVELOPMENTS</p><h2>Looking forward,<br><em>with intention.</em></h2><p>Browse conceptual new-build collections, sample floor plans and fictional handover examples.</p><a class="solid-button" href={`${p}developments/`}>Explore developments ↗</a></div><img src={`${p}assets/horizon.webp`} alt="AI-generated conceptual facade, not a real development" width="1200" height="675" loading="lazy"/></section>
 <section class="closing container"><h2>There is more than<br><em>one way home.</em></h2><div><p>Whether the search begins with a neighbourhood or a lifestyle, explore an experience built to support each step.</p><a href={`${p}buy/`}>Buying guide ↗</a><a href={`${p}sell/`}>Selling guide ↗</a></div></section>
</Layout>
