---
import Layout from '@estate/ui/PortfolioLayout.astro';
import { properties, areas, developments, formatPrice } from '../data/inventory';
import { nav } from '../data/nav';
import '../styles/global.css';
const p = import.meta.env.BASE_URL;
const heroProperty = properties[0];
const featured = properties.slice(0,3);
---
<Layout title="ATELIER Estates | Modern Luxury Property Collection — Demo" description="Explore six fictional Dubai residences, concept developments and neighbourhood stories in an original gallery-style brokerage portfolio." brand="ATELIER ESTATES" nav={nav(p)} accent="#111313">
  <section class="a5-hero" aria-labelledby="a5-hero-title">
    <div class="a5-hero-copy">
      <p class="a5-kicker">ATELIER / AN ORIGINAL PRIVATE PROPERTY GALLERY</p>
      <h1 id="a5-hero-title">THE ART<br/>OF <span>LIVING.</span></h1>
      <p class="a5-hero-intro">Distinctive homes. Considered spaces. Discover what makes a place feel like your own.</p>
      <form action={`${p}properties/`} method="get" class="a5-search" aria-label="Search fictional property collection">
        <label>NEIGHBOURHOOD<select name="area"><option value="">Any area</option>{areas.map(area=><option value={area.slug}>{area.name}</option>)}</select></label>
        <label>PROPERTY TYPE<select name="type"><option value="">All property types</option>{['Penthouse','Villa','Apartment','Duplex','Townhouse'].map(type=><option value={type}>{type}</option>)}</select></label>
        <label>MAX. PRICE<select name="price"><option value="">Any budget</option><option value="3000000">AED 3M</option><option value="5000000">AED 5M</option><option value="10000000">AED 10M</option><option value="20000000">AED 20M</option></select></label>
        <button type="submit">FIND A HOME <span aria-hidden="true">↗</span></button>
      </form>
      <p class="a5-hero-disclosure">01 / 06 STUDIES · All properties and values are fictional demo content</p>
    </div>
    <figure class="a5-hero-image"><img src={`${p}assets/brokerage-noir.webp`} width="1200" height="780" fetchpriority="high" alt="Original monochrome penthouse concept visual used as a fictional editorial property study"/><figcaption>ATELIER / PRIVATE COLLECTION · CONCEPT STUDY</figcaption></figure>
  </section>

  <section class="a5-collection container" id="featured" aria-labelledby="a5-featured-title">
    <div class="a5-section-head"><div><p class="a5-kicker">01 / THE PRIVATE COLLECTION</p><h2 id="a5-featured-title">SELECTED<br/><span>RESIDENCES.</span></h2></div><a class="a5-text-link" href={`${p}properties/`}>VIEW THE COLLECTION <span aria-hidden="true">↗</span></a></div>
    <div class="a5-featured-grid">{featured.map((item,i)=><a href={`${p}properties/${item.slug}/`} class:list={['a5-featured-tile',{'a5-featured-primary':i===0}]} data-track="view_property"><div class="a5-photo-wrap"><img src={`${p}assets/${item.image}`} alt={`Original fictional concept artwork for ${item.name}`} width="1200" height="675" loading="lazy"/><span class="a5-concept-label">0{i+1} / PROPERTY STUDY</span></div><div class="a5-tile-caption"><div><small>{item.area} / {item.type}</small><h3>{item.name}</h3></div><div><strong>{formatPrice(item.price)}</strong><span>{item.bedrooms} BEDS · {item.size.toLocaleString('en-US')} SQ.FT</span></div></div></a>)}</div>
  </section>

  <section class="a5-filter-band" aria-labelledby="a5-filter-title"><div class="container a5-filter-inner"><div><p class="a5-kicker">02 / DISCOVER THE COLLECTION</p><h2 id="a5-filter-title">A HOME FOR<br/>EVERY <span>PERSPECTIVE.</span></h2></div><div class="a5-filter-links"><p>Start where your search matters most.</p><a href={`${p}properties/?type=Penthouse`}>PENTHOUSES <span aria-hidden="true">↗</span></a><a href={`${p}properties/?type=Villa`}>VILLAS <span aria-hidden="true">↗</span></a><a href={`${p}properties/?status=Off-plan`}>OFF-PLAN CONCEPTS <span aria-hidden="true">↗</span></a></div></div></section>

  <section class="a5-areas container" aria-labelledby="a5-area-title"><div class="a5-section-head"><div><p class="a5-kicker">03 / WHERE LIFE HAPPENS</p><h2 id="a5-area-title">EXPLORE<br/><span>NEIGHBOURHOODS.</span></h2></div><a class="a5-text-link" href={`${p}areas/`}>ALL AREA GUIDES ↗</a></div><div class="a5-areas-grid">{areas.map((area,i)=><a class="a5-area" href={`${p}areas/${area.slug}/`}><img src={`${p}assets/${area.image}`} alt={`Fictional residential visual illustrating ${area.name}; not a real area photograph`} width="1200" height="675" loading="lazy"/><div><span>0{i+1} / AREA STUDY</span><h3>{area.name}</h3><p>{area.character}</p><strong aria-hidden="true">↗</strong></div></a>)}</div></section>

  <section class="a5-signature" aria-labelledby="a5-signature-title"><div class="a5-signature-image"><img src={`${p}assets/courtyard.webp`} alt="Original fictional courtyard residence architectural concept" width="1200" height="675" loading="lazy"/></div><div class="a5-signature-copy"><p class="a5-kicker">04 / PROPERTY STUDY</p><h2 id="a5-signature-title">MORE THAN<br/>AN <span>ADDRESS.</span></h2><p>Warm materials, carefully considered proportions and rooms shaped around the way people actually live.</p><div class="a5-signature-facts"><span>COURTYARD VILLA</span><span>DUBAI HILLS · CONCEPT</span></div><a class="a5-action" href={`${p}properties/courtyard-villa/`}>EXPLORE THE RESIDENCE <span aria-hidden="true">↗</span></a></div></section>

  <section class="a5-developments container" aria-labelledby="a5-development-title"><div class="a5-section-head"><div><p class="a5-kicker">05 / LOOKING AHEAD</p><h2 id="a5-development-title">NEW<br/><span>DEVELOPMENTS.</span></h2></div><a class="a5-text-link" href={`${p}developments/`}>VIEW ALL CONCEPTS ↗</a></div><div class="a5-developments-grid">{developments.map((dev,i)=><a href={`${p}developments/${dev.slug}/`} class="a5-development" data-track="view_development"><img src={`${p}assets/${dev.image}`} alt={`Fictional architectural concept ${dev.name}`} width="1200" height="675" loading="lazy"/><div><span>0{i+1} / FICTIONAL DEVELOPMENT</span><h3>{dev.name}</h3><p>{dev.area} · {dev.residences}</p><strong aria-hidden="true">↗</strong></div></a>)}</div></section>

  <section class="a5-services" aria-labelledby="a5-services-title"><div class="container"><p class="a5-kicker">06 / YOUR NEXT MOVE</p><h2 id="a5-services-title">BUYING WITH CLARITY.<br/><span>SELLING WITH INTENTION.</span></h2><div class="a5-services-grid"><a href={`${p}buy/`}><span>01 / BUY</span><h3>THE BUYER'S GUIDE</h3><p>Explore the stages and considerations involved in finding your next property.</p><strong>EXPLORE THE PROCESS ↗</strong></a><a href={`${p}sell/`}><span>02 / SELL</span><h3>THE SELLER'S GUIDE</h3><p>Understand presentation, pricing questions and the practical steps of a sale.</p><strong>EXPLORE THE PROCESS ↗</strong></a></div></div></section>

  <section class="a5-insights container" aria-labelledby="a5-insights-title"><div class="a5-section-head"><div><p class="a5-kicker">07 / THE EDITORIAL</p><h2 id="a5-insights-title">A CLOSER <span>LOOK.</span></h2></div><a class="a5-text-link" href={`${p}insights/`}>EXPLORE INSIGHTS ↗</a></div><div class="a5-insights-grid"><a href={`${p}insights/`}><span>01 / BUYING GUIDE</span><h3>UNDERSTANDING PURCHASE COSTS IN DUBAI</h3><strong>READ THE GUIDE ↗</strong></a><a href={`${p}insights/`}><span>02 / OFF-PLAN</span><h3>WHAT TO VERIFY BEFORE COMMITTING</h3><strong>READ THE GUIDE ↗</strong></a><a href={`${p}areas/`}><span>03 / NEIGHBOURHOODS</span><h3>HOW TO CHOOSE A LOCATION</h3><strong>EXPLORE THE AREAS ↗</strong></a></div></section>

  <section class="a5-end" aria-labelledby="a5-end-title"><div class="container a5-end-inner"><div><p class="a5-kicker">08 / TAKE THE NEXT STEP</p><h2 id="a5-end-title">A PRIVATE VIEW.<br/><span>A NEW PERSPECTIVE.</span></h2><p>Explore a fictional collection or try a sample property enquiry.</p></div><a class="a5-action" href={`${p}contact/`}>START A CONVERSATION <span aria-hidden="true">↗</span></a></div></section>
</Layout>