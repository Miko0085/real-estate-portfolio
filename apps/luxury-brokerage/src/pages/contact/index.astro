---
import Layout from '@estate/ui/PortfolioLayout.astro';
import {nav} from '../../data/nav';
import '../../styles/global.css';
const p=import.meta.env.BASE_URL;
const endpoint=import.meta.env.PUBLIC_LEAD_ENDPOINT || '';
---
<Layout title="Contact | ATELIER Estates — Demo Enquiry" description="A fictional luxury brokerage contact form with optional qualification and consent. No leads are sent by default." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
<section class="page-heading container"><p class="eyebrow">START THE CONVERSATION</p><h1>Contact<span class="period">.</span></h1><p>Have a specific property or development in mind? Tell us what you are looking for.</p></section><section class="container contact-layout" id="enquire"><div class="contact-intro"><p class="eyebrow">DISCOVER WHAT'S NEXT</p><h2>Make your next<br>move considered.</h2><p>This is a portfolio demo of a qualified enquiry experience. No brokerage operates behind this brand and no request will be delivered unless a verified endpoint is configured.</p><p class="support-note">No phone numbers or agents are invented for this demonstration.</p></div>
<form id="atelier-enquiry" class="contact-form" data-capture-form data-endpoint={endpoint} method="post" action={`${p}api/lead`}><div class="honeypot" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off"/></label></div><h3>Your enquiry</h3><p>All fields marked * are required to send a real enquiry.</p><div class="form-two"><label>Full name *<input type="text" name="name" autocomplete="name" minlength="2" required placeholder="Your full name"/></label><label>Email *<input type="email" name="email" autocomplete="email" required placeholder="you@example.com"/></label><label>Phone<input type="tel" name="phone" autocomplete="tel" placeholder="+1 555 000 0000"/></label><label>Enquiry type<select name="purpose" required><option value="">Choose one</option><option>Buy a property</option><option>Sell a property</option><option>Explore developments</option><option>General enquiry</option></select></label></div><label>Your requirements<textarea name="message" maxlength="1200" rows="5" placeholder="Area, bedrooms, budget, timeline, or sample listing name"></textarea></label><label class="consent"><input type="checkbox" name="consent" required/><span>I consent to being contacted about this enquiry if an operator is configured. <a href={`${p}privacy/`}>Privacy notice</a>.</span></label><button type="submit" class="solid-button">Submit enquiry ↗</button><p data-feedback role="status" aria-live="polite"></p></form></section>
</Layout>
