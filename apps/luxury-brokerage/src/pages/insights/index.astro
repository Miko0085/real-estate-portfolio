---
import Layout from '@estate/ui/PortfolioLayout.astro';import {nav} from '../../data/nav';import '../../styles/global.css';const p=import.meta.env.BASE_URL;
---
<Layout title="Insights | ATELIER Estates — Educational Notes" description="Illustrative property buyer and seller education, without real market statistics." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423"><section class="page-heading container"><p class="eyebrow">NOTES / FOR CONSIDERED DECISIONS</p><h1>Insights<span class="period">.</span></h1><p>Educational examples about property decisions; no live market claims or forecasts.</p></section><section class="container insight-grid"><article><span class="eyebrow">BUYING / GUIDE</span><h2>Beyond the asking price</h2><p>Consider acquisition fees, annual service charges, furnishing, financing, possible vacancy and ownership structure.</p><a href={`${p}buy/`}>Buying considerations ↗</a></article><article><span class="eyebrow">SELLING / GUIDE</span><h2>Preparing for the market</h2><p>Accurate specifications, thoughtful presentation and realistic pricing are fundamental parts of an effective selling process.</p><a href={`${p}sell/`}>Selling considerations ↗</a></article><article><span class="eyebrow">LOCATION / GUIDE</span><h2>How neighbourhoods shape value</h2><p>Look at daily convenience, transport, density, amenities and future supply, not only a postcode or skyline.</p><a href={`${p}areas/`}>Explore areas ↗</a></article></section></Layout>
