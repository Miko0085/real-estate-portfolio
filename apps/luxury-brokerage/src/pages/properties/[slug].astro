---
import Layout from '@estate/ui/PortfolioLayout.astro';
import {properties,formatPrice,type EstateProperty} from '../../data/inventory';
import {nav} from '../../data/nav';
import '../../styles/global.css';
export function getStaticPaths(){return properties.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props as {item:EstateProperty};
const p=import.meta.env.BASE_URL;
---
<Layout title={`${item.name} | ATELIER Estates — Fictional Listing`} description={`${item.name}, ${item.area}: a fictional ${item.bedrooms}-bedroom ${item.type.toLowerCase()} concept. All prices and specifications are samples.`} brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href={p}>Home</a><span>/</span><a href={`${p}properties/`}>Properties</a><span>/</span><span aria-current="page">{item.name}</span></nav>
 <section class="detail-heading container"><div><p class="eyebrow">SAMPLE RESIDENCE / {item.status.toUpperCase()}</p><h1>{item.name}</h1><p>{item.area} · {item.type} · Portfolio concept</p></div><strong>{formatPrice(item.price)}<small>ILLUSTRATIVE PRICE</small></strong></section>
 <section class="detail-gallery container"><img src={`${p}assets/${item.image}`} alt={`Original architectural illustration for fictional ${item.name}`} width="1200" height="675" fetchpriority="high"/><div class="side-art"><img src={`${p}assets/${item.image}`} alt="Alternative crop of fictional property concept" width="1200" height="675" loading="lazy"/><div>IMAGINED PROPERTY / NOT FOR SALE</div></div></section>
 <section class="detail-body container"><article><p class="eyebrow">01 / THE RESIDENCE</p><h2>Space with character.</h2><p>{item.description}</p><h3>Details worth noticing</h3><ul>{item.features.map(feature=><li>{feature}</li>)}</ul></article><aside class="specification"><p class="eyebrow">AT A GLANCE</p><dl><div><dt>Location</dt><dd>{item.area}</dd></div><div><dt>Property type</dt><dd>{item.type}</dd></div><div><dt>Bedrooms</dt><dd>{item.bedrooms}</dd></div><div><dt>Internal area (sample)</dt><dd>{item.size.toLocaleString('en-US')} sq ft</dd></div><div><dt>Status</dt><dd>{item.status}</dd></div><div><dt>Indicative price</dt><dd>{formatPrice(item.price)}</dd></div></dl><a class="solid-button" href={`${p}contact/?property=${item.slug}#enquire`}>Enquire about this concept ↗</a><p>Demonstration only. No agent, property availability, or seller is represented.</p></aside></section>
 <section class="container detail-related"><div class="section-header"><h2>Explore more residences</h2><a href={`${p}properties/`}>All properties ↗</a></div><div class="property-grid">{properties.filter(x=>x.slug!==item.slug).slice(0,2).map(next=><a class="property-card" href={`${p}properties/${next.slug}/`}><img src={`${p}assets/${next.image}`} alt={`Fictional architectural concept ${next.name}`} width="1200" height="675" loading="lazy"/><div class="property-text"><span>{next.area}</span><h3>{next.name}</h3><p>{formatPrice(next.price)}</p></div></a>)}</div></section>
</Layout>
