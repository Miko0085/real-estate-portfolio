---
import Layout from '@estate/ui/PortfolioLayout.astro';
import { properties, formatPrice, type EstateProperty } from '../../data/inventory';
import { nav } from '../../data/nav';
import '../../styles/global.css';
export function getStaticPaths(){return properties.map(item=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props as {item:EstateProperty};
const p=import.meta.env.BASE_URL;
const related=properties.filter(next=>next.slug!==item.slug && (next.areaSlug===item.areaSlug || next.type===item.type)).slice(0,2);
const recommendations=related.length>0?related:properties.filter(next=>next.slug!==item.slug).slice(0,2);
---
<Layout title={`${item.name} | ATELIER Estates — Fictional Listing`} description={`${item.name}, ${item.area}: a fictional ${item.bedrooms}-bedroom ${item.type.toLowerCase()} concept. All prices and specifications are samples.`} brand="ATELIER ESTATES" nav={nav(p)} accent="#111313">
  <nav class="breadcrumbs container" aria-label="Breadcrumb"><a href={p}>Home</a><span>/</span><a href={`${p}properties/`}>The collection</a><span>/</span><span aria-current="page">{item.name}</span></nav>
  <header class="a5-property-intro container"><div><p class="a5-kicker">THE PRIVATE COLLECTION / FICTIONAL RESIDENCE</p><h1>{item.name.toUpperCase()}</h1><p>{item.area} · {item.type} · Concept study</p></div><div class="a5-property-price"><strong>{formatPrice(item.price)}</strong><small>ILLUSTRATIVE PRICE · NOT FOR SALE</small></div></header>
  <section class="a5-property-stage container" aria-label={`Concept image of ${item.name}`}><figure><img src={`${p}assets/${item.image}`} alt={`Original illustration of fictional ${item.name}; this is the only verified concept frame, not a real listing photograph`} width="1200" height="675" fetchpriority="high"/><figcaption>01 / ORIGINAL FICTIONAL ARCHITECTURAL CONCEPT · NOT A REAL PROPERTY</figcaption></figure><div class="a5-property-sidebar"><p class="a5-kicker">INSIDE THE CONCEPT</p><h2>AN ORIGINAL<br/>STUDY IN <span>SPACE.</span></h2><p>{item.teaser}</p><div class="a5-property-sidefacts"><div><span>LOCATION</span><strong>{item.area}</strong></div><div><span>BEDROOMS</span><strong>{item.bedrooms.toString().padStart(2,'0')}</strong></div><div><span>AREA · SAMPLE</span><strong>{item.size.toLocaleString('en-US')} SQ.FT</strong></div></div><a href={`${p}contact/?property=${item.slug}#enquire`} class="a5-action">ENQUIRE ABOUT THIS CONCEPT ↗</a></div></section>
  <section class="container a5-detail-honesty"><span>MEDIA NOTE / 01 AVAILABLE CONCEPT IMAGE</span><p>This property currently has one original illustration. Additional interior and exterior views will appear only once their visual consistency has been verified. No duplicate crops are presented as separate photographs.</p></section>
  <section class="container a5-property-information"><div><p class="a5-kicker">01 / THE RESIDENCE</p><h2>THE DETAILS<br/><span>MAKE THE PLACE.</span></h2><p>{item.description}</p><h3>SPACES &amp; FEATURES</h3><ul>{item.features.map(feature=><li>{feature}</li>)}</ul></div><aside class="a5-property-spec"><p class="a5-kicker">AT A GLANCE</p><dl><div><dt>Neighbourhood</dt><dd>{item.area}</dd></div><div><dt>Property type</dt><dd>{item.type}</dd></div><div><dt>Bedrooms</dt><dd>{item.bedrooms}</dd></div><div><dt>Internal area</dt><dd>{item.size.toLocaleString('en-US')} sq ft</dd></div><div><dt>Concept stage</dt><dd>{item.status} · Sample</dd></div><div><dt>Indicative price</dt><dd>{formatPrice(item.price)}</dd></div></dl><a class="a5-action" href={`${p}contact/?property=${item.slug}#enquire`}>DISCUSS THIS RESIDENCE ↗</a><p>No actual inventory, booking, registered agent or sale is represented.</p></aside></section>
  <section class="container a5-related" aria-labelledby="related-title"><div class="a5-section-head"><div><p class="a5-kicker">02 / KEEP EXPLORING</p><h2 id="related-title">OTHER <span>RESIDENCES.</span></h2></div><a href={`${p}properties/`} class="a5-text-link">ALL PROPERTIES ↗</a></div><div class="a5-related-grid">{recommendations.map(next=><a href={`${p}properties/${next.slug}/`} class="a5-related-item"><img src={`${p}assets/${next.image}`} alt={`Concept illustration of fictional ${next.name}`} width="1200" height="675" loading="lazy"/><div><h3>{next.name}</h3><span>{next.area} · {formatPrice(next.price)} (sample)</span></div></a>)}</div></section>
</Layout>