---
import Layout from '@estate/ui/PortfolioLayout.astro';
import { properties,formatPrice } from '../../data/inventory';
import {nav} from '../../data/nav';
import '../../styles/global.css';
const p=import.meta.env.BASE_URL;
---
<Layout title="Properties | ATELIER Estates — Sample Catalogue" description="Filter fictional Dubai properties by area, type, bedrooms, price and ready or off-plan status." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <section class="page-heading container"><p class="eyebrow">THE COLLECTION / DEMONSTRATION</p><h1>Properties<span class="period">.</span></h1><p>Search a curated example inventory. Every property, price and specification below is fictional.</p></section>
 <section class="container listing-layout"><form id="property-filters" class="filter-bar" aria-label="Property catalogue filters" data-filters>
 <label>Neighbourhood<select name="area"><option value="">All areas</option><option value="palm-jumeirah">Palm Jumeirah</option><option value="dubai-hills">Dubai Hills</option><option value="dubai-marina">Dubai Marina</option></select></label>
 <label>Property type<select name="type"><option value="">All types</option>{['Penthouse','Villa','Apartment','Duplex','Townhouse'].map(t=><option value={t}>{t}</option>)}</select></label>
 <label>Bedrooms<select name="beds"><option value="">Any</option>{[1,2,3,4,5].map(n=><option value={n}>{n}+</option>)}</select></label>
 <label>Maximum price<select name="price"><option value="">No maximum</option><option value="3000000">AED 3M</option><option value="5000000">AED 5M</option><option value="10000000">AED 10M</option><option value="20000000">AED 20M</option></select></label>
 <label>Status<select name="status"><option value="">All</option><option value="Ready">Ready</option><option value="Off-plan">Off-plan</option></select></label>
 <button type="reset">Clear filters ↺</button></form>
 <div class="listing-count" role="status" aria-live="polite"><strong data-result-count>{properties.length} properties</strong><span>Demo catalogue · no live availability</span></div>
 <div class="property-grid catalogue-grid" data-results>{properties.map(item=><a href={`${p}properties/${item.slug}/`} class="property-card" data-property data-area={item.areaSlug} data-type={item.type} data-beds={item.bedrooms} data-price={item.price} data-status={item.status} data-track="view_property"><img src={`${p}assets/${item.image}`} alt={`Fictional architectural illustration of ${item.name}`} width="1200" height="675" loading="lazy"/><span class="card-index">{item.status} · SAMPLE</span><div class="property-text"><span>{item.area} / {item.type}</span><h2>{item.name}</h2><p>{formatPrice(item.price)} <span>· {item.bedrooms} beds · {item.size.toLocaleString('en-US')} sq ft</span></p></div></a>)}</div>
 <p class="no-results" data-no-results hidden>No sample properties match these filters. <button type="button" data-reset-filters>Clear filters</button></p>
 </section>
</Layout>
<script>import '../../scripts/catalogue.ts';</script>
