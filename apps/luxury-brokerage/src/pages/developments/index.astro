---
import Layout from '@estate/ui/PortfolioLayout.astro';
import { developments } from '../../data/inventory';
import {nav} from '../../data/nav';
import '../../styles/global.css';
const p=import.meta.env.BASE_URL;
---
<Layout title="Developments | ATELIER Estates — Demo" description="Explore sample new-build development concepts with fictional residences and indicative handover periods." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423">
 <section class="page-heading container"><p class="eyebrow">NEW PLACES / SAMPLE PROJECTS</p><h1>Developments<span class="period">.</span></h1><p>Imagined residential collections. No underlying developer or construction project exists.</p></section>
 <section class="container development-list">{developments.map((d,i)=><a class="development-row" href={`${p}developments/${d.slug}/`} data-track="view_development"><img src={`${p}assets/${d.image}`} alt={`Architectural concept artwork for fictional ${d.name}`} width="1200" height="850" loading="lazy"/><div><span class="eyebrow">0{i+1} / {d.area}</span><h2>{d.name}</h2><p>{d.headline}</p><span class="small-link">Explore concept ↗</span></div></a>)}</section>
</Layout>
