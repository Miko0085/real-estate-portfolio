---
import Layout from '@estate/ui/PortfolioLayout.astro';import {nav} from '../../data/nav';import '../../styles/global.css';const p=import.meta.env.BASE_URL;
---
<Layout title="Buy | ATELIER Estates — Home Buying Guide" description="A simple sample buying journey for luxury property in Dubai, with transparent fictional inventory." brand="ATELIER / ESTATES" nav={nav(p)} accent="#242423"><section class="page-heading container"><p class="eyebrow">BUYING / A CONSIDERED JOURNEY</p><h1>Finding your<br>next chapter<span class="period">.</span></h1><p>From defining the search to understanding costs and the purchase process.</p></section><section class="container editorial-guide"><div><p class="eyebrow">YOUR NEXT STEPS</p><h2>Clarity before commitment.</h2></div><ol><li><h3>Define the brief</h3><p>Choose your preferred neighbourhoods, lifestyle, property type, budget and purchase timeline.</p></li><li><h3>Evaluate the options</h3><p>Compare homes, verify availability and review ownership rules, service charges and condition.</p></li><li><h3>Review the transaction</h3><p>Seek qualified local advice on fees, financing, documentation and contractual commitments.</p></li></ol></section><section class="container guide-cta"><h2>Start with the collection.</h2><a class="solid-button" href={`${p}properties/`}>Explore sample properties ↗</a></section></Layout>
