import Layout from '@estate/ui/PortfolioLayout.astro';import '../../styles/global.css';const p=import.meta.env.BASE_URL;
---
<Layout title="Privacy & Demo Notice | SERA / COAST" description="Privacy and illustrative property information for the fictional SERA / COAST development microsite." brand="SERA / COAST" nav={[{label:'Residences',href:p+'#residences'},{label:'Enquire',href:p+'#enquire'}]} accent="#302520"><section class="legal container"><p class="eyebrow">DEMONSTRATION / PRIVACY</p><h1>Privacy and<br><em>concept notice.</em></h1><p>SERA / COAST is a fictional project; no real development, property, developer or brokerage relationship exists.</p><h2>Enquiries</h2><p>Forms validate locally. Without a configured secure endpoint, personal information is not submitted or stored. Before live use a verified operator must publish its identity, legal basis, purpose, retention and data-rights procedures.</p><h2>Illustrative information</h2><p>All floor plans, residences, images, payment milestones and handover dates are original hypothetical examples. They are not a contractual or investment representation.</p><h2>Attribution</h2><p>Campaign details may be temporarily stored in browser session storage. Analytics are off by default.</p><a href={p}>← Return to concept</a></section></Layout>
