---
import '../styles/global.css';
import Seo from '@estate/seo/Seo.astro';
const home = Astro.site || new URL('https://example.com/');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><Seo title="SERA / COAST — portfolio concept (not launched)" description="Original real-estate website portfolio scaffold. Not a live property business." canonical={home.toString()} image={new URL('og-cover.svg',home).toString()} noindex={true} /></head>
<body><main class="placeholder"><div class="label">REAL ESTATE PORTFOLIO / NOT LAUNCHED</div><div class="divider"></div><p class="brand">SERA / COAST</p><h1>Built around the art of living.</h1><p class="description">The fictional developer’s visual microsite is planned, not yet implemented.</p><div class="lower"><span>ORIGINAL DESIGN DIRECTION</span><span>REFERENCE RESEARCH COMPLETE · IMPLEMENTATION PENDING</span></div></main><footer>Fictional brand · portfolio design exploration · <a href={import.meta.env.BASE_URL}>Home</a></footer></body></html>
